#!/system/bin/sh
# Noxis Recovery – Wi-Fi for the Nothing Phone (3a) (qca6750 / icnss2), EXPERIMENTAL
#
#   noxis-wifi probe                 collect hardware info only (changes nothing)
#   noxis-wifi up                    load the Wi-Fi driver + firmware services
#   noxis-wifi scan                  list networks
#   noxis-wifi connect SSID [PASS]   connect (WPA2/WPA3-transition or open) + DHCP
#   noxis-wifi status | down
#
# Everything is logged to /tmp/noxis-wifi.log – send that file when something fails:
#   adb pull /tmp/noxis-wifi.log
LOG=/tmp/noxis-wifi.log
BB=/system/bin/nxbusybox
ip() { $BB ip "$@"; }
SLOT=$(getprop ro.boot.slot_suffix)
V=/mnt/nx/vendor
D=/mnt/nx/vendor_dlkm
RUN=/tmp/nxwifi
mkdir -p $RUN
export LD_LIBRARY_PATH=/mnt/nx/vendor/lib64:/vendor/lib64:/system/lib64

log() { echo "[noxis-wifi] $*" | tee -a $LOG; }
run() { echo "+ $*" >> $LOG; "$@" >> $LOG 2>&1; _rc=$?; [ $_rc -ne 0 ] && echo "  -> exit $_rc" >> $LOG; return $_rc; }

mount_part() { # name mountpoint
  mkdir -p "$2"
  mountpoint -q "$2" && return 0
  for dev in /dev/block/mapper/$1$SLOT /dev/block/mapper/$1 /dev/block/by-name/$1$SLOT; do
    [ -e "$dev" ] || continue
    for fs in erofs ext4; do
      mount -t $fs -o ro "$dev" "$2" 2>>$LOG && { log "mounted $dev ($fs) -> $2"; return 0; }
    done
  done
  log "! could not mount $1 (dynamic partitions not mapped? open Mount in OrangeFox once)"
  return 1
}

SD=/mnt/nx/system_dlkm
MODDIRS=""
moddirs() {
  [ -n "$MODDIRS" ] && return
  for d in $D/lib/modules /vendor_dlkm/lib/modules $SD/lib/modules $SD/lib/modules/* /lib/modules $V/lib/modules; do
    [ -f "$d/modules.dep" ] && MODDIRS="$MODDIRS $d"
  done
  log "module dirs:$MODDIRS"
}
findko() { for d in $MODDIRS; do f=$(find "$d" -name "$1.ko" 2>/dev/null | head -1); [ -n "$f" ] && { echo "$f"; return; }; done; }
loaded() { grep -q "^$(echo "$1" | tr - _) " /proc/modules; }
load_mod() { # name – loads its dependencies first
  loaded "$1" && return 0
  for d in $MODDIRS; do
    line=$(grep -E "(^|/)$1\.ko:" "$d/modules.dep" 2>/dev/null | head -1)
    [ -n "$line" ] && break
  done
  for dep in ${line#*:}; do
    b=$(basename "$dep" .ko); [ "$b" = "$1" ] || load_mod "$b"
  done
  f=$(findko "$1")
  [ -n "$f" ] || { log "! module $1.ko not found"; return 1; }
  run insmod "$f"
}

mods_dir() { for d in $D/lib/modules /vendor_dlkm/lib/modules $V/lib/modules; do [ -f $d/modules.dep ] && { echo $d; return; }; done; }

probe() {
  log "=== probe $(date) slot=$SLOT kernel=$(uname -r)"
  mount_part vendor $V; mount_part vendor_dlkm $D
  run ls /sys/class/remoteproc
  for r in /sys/class/remoteproc/*; do echo "$r: $(cat $r/name 2>/dev/null) $(cat $r/state 2>/dev/null) fw=$(cat $r/firmware 2>/dev/null)" >> $LOG; done
  run lsmod
  M=$(mods_dir); log "modules dir: ${M:-none}"
  [ -n "$M" ] && run sh -c "ls $M | grep -iE 'cnss|wlan|qca|icnss|qrtr|rproc|ipc' "
  run ls $V/bin/cnss-daemon $V/bin/pd-mapper $V/bin/pm-service $V/bin/hw/wpa_supplicant $V/bin/qrtr-ns
  run sh -c "find /vendor/firmware_mnt/image $V/firmware -iname '*wpss*' -o -iname 'bdwlan*' -o -iname 'regdb*' 2>/dev/null | head -30"
  run sh -c "grep -rhE 'cnss|wpss|wlan' $V/etc/init/*.rc $V/etc/init/hw/*.rc | head -60"
  run cat /sys/module/firmware_class/parameters/path
  run ls /sys/kernel/cnss /sys/bus/platform/drivers | head -5
  run $BB ip link
  log "=== probe done – send /tmp/noxis-wifi.log"
}

up() {
  log "=== up $(date)"
  if [ -e /sys/class/net/wlan0 ]; then run ifconfig wlan0 up; log "OK: wlan0 is already up"; return 0; fi
  mount_part vendor $V || return 1
  mount_part vendor_dlkm $D
  mountpoint -q /vendor/firmware_mnt || mount -t vfat -o ro /dev/block/by-name/modem$SLOT /vendor/firmware_mnt 2>>$LOG
  # firmware: one merged folder (modem partition first, then vendor), the kernel loads from there
  FW=/tmp/nxfw; mkdir -p $FW
  for src in /vendor/firmware_mnt/image $V/firmware /vendor/firmware; do
    [ -d "$src" ] || continue
    for e in "$src"/*; do b=$(basename "$e"); [ -e "$FW/$b" ] || [ -L "$FW/$b" ] || ln -s "$e" "$FW/$b" 2>/dev/null; done
  done
  echo -n $FW > /sys/module/firmware_class/parameters/path
  # vendor firmware links point to absolute /vendor/etc/... paths – in recovery /vendor is the
  # ramdisk, so copy the Wi-Fi config there (WCNSS_qcom_cfg.ini etc.)
  if [ -d $V/etc/wifi ] && [ ! -e /vendor/etc/wifi/qca6750/WCNSS_qcom_cfg.ini ]; then
    mkdir -p /vendor/etc/wifi && cp -r $V/etc/wifi/. /vendor/etc/wifi/ && log "copied vendor/etc/wifi"
  fi
  run ls -l $V/firmware/wlan/qca_cld/qca6750/
  w=$(find /vendor/firmware_mnt/image $V/firmware -name 'wpss.mdt' 2>/dev/null | head -3 | tr '\n' ' ')
  log "wpss.mdt found at: ${w:-NOWHERE}"
  # the remoteproc asks for qca6750/wpss.mdt – link it if the file sits elsewhere
  if [ ! -e $FW/qca6750/wpss.mdt ] && [ -n "$w" ]; then
    wd=$(dirname ${w%% *}); rm -f $FW/qca6750; ln -s "$wd" $FW/qca6750
  fi
  export LD_LIBRARY_PATH=$V/lib64:/vendor/lib64:/system/lib64
  # 1) kernel modules (dependencies come from modules.dep)
  mount_part system_dlkm $SD
  moddirs
  # 1) base modules (cfg80211 lives in system_dlkm on GKI kernels)
  for m in rfkill cfg80211 qrtr qrtr-smd rproc_qcom_common cnss_prealloc cnss_utils cnss_nl wlan_firmware_service cnss_plat_ipc_qmi_svc; do
    load_mod $m
  done
  # 2) modem: the Wi-Fi driver reads its MAC address from the modem (DMS service),
  #    so the modem has to run first – with its storage helpers from the vendor partition
  mkdir -p /mnt/vendor/persist
  mountpoint -q /mnt/vendor/persist || mount -t ext4 -o ro /dev/block/by-name/persist /mnt/vendor/persist 2>>$LOG
  for d in pd-mapper rmt_storage tftp_server pm-service; do
    [ -x $V/bin/$d ] || { log "  (no $d)"; continue; }
    pidof $d >/dev/null || { run sh -c "$V/bin/$d >>$LOG 2>&1 &"; log "started $d"; }
  done
  sleep 1
  for rp in /sys/class/remoteproc/*; do
    n=$(cat $rp/name 2>/dev/null)
    case "$n" in *-mss|*mpss*|*modem*)
      [ "$(cat $rp/state)" = running ] || run sh -c "echo start > $rp/state"
      log "$n: $(cat $rp/state)";;
    esac
  done
  log "waiting 15 s for the modem services ..."; sleep 15
  run sh -c "dmesg | grep -iE 'remoteproc-mss|remoteproc3' | tail -8"
  # 3) Wi-Fi platform driver + wireless processor (WPSS) + WLAN host driver
  load_mod icnss2
  for rp in /sys/class/remoteproc/*; do
    n=$(cat $rp/name 2>/dev/null)
    case "$n" in *wpss*) [ "$(cat $rp/state)" = running ] || run sh -c "echo start > $rp/state"; sleep 2; log "$n: $(cat $rp/state)";; esac
  done
  load_mod qca_cld3_qca6750
  for f in /sys/kernel/boot_wlan/boot_wlan; do [ -e $f ] && { run sh -c "echo 1 > $f"; log "boot_wlan triggered"; }; done
  pidof cnss-daemon >/dev/null || { run sh -c "$V/bin/cnss-daemon -n -l >>$LOG 2>&1 &"; }
  # qcacld only creates wlan0 when the Wi-Fi HAL switches it on – do that ourselves
  i=0; while [ $i -lt 30 ] && [ ! -e /dev/wlan ]; do sleep 1; i=$((i+1)); done
  sleep 3
  if [ -e /dev/wlan ]; then run sh -c "echo ON > /dev/wlan"; log "driver switched ON"; else log "! /dev/wlan missing"; fi
  for f in /sys/kernel/cnss/fs_ready /sys/kernel/icnss/fs_ready; do [ -e $f ] && echo 1 > $f; done
  log "loaded: $(grep -oE '^(icnss2|cnss2|qca_cld3_qca6750|wlan|cnss_[a-z_]+|qrtr[a-z_]*|wlan_firmware_service) ' /proc/modules | tr '\n' ' ')"
  # 4) wait for wlan0
  i=0; while [ $i -lt 40 ] && ! [ -e /sys/class/net/wlan0 ]; do sleep 1; i=$((i+1)); done
  if [ -e /sys/class/net/wlan0 ]; then
    run ifconfig wlan0 up; log "OK: wlan0 is up"
  else
    run sh -c "dmesg | grep -iE 'icnss|wlan|hdd|qca_cld|cfg.ini|DMS MAC|probe|firmware load' | grep -v 'DMS QMI connection not established' | tail -60"
    run sh -c "for r in /sys/class/remoteproc/*; do echo \$(cat \$r/name) \$(cat \$r/state); done"
    log "! wlan0 did not appear – send /tmp/noxis-wifi.log"; return 1
  fi
}

WPA=/mnt/nx/vendor/bin/hw/wpa_supplicant
supplicant() { # conf – runs in the background, debug output goes to $RUN/wpa.out
  pkill -f "wpa_supplicant.*$RUN" 2>/dev/null; sleep 1
  [ -x $WPA ] || { mount_part vendor $V; }
  : > $RUN/wpa.out
  echo "+ wpa_supplicant -iwlan0 -Dnl80211 -c $1 -dd" >> $LOG
  # bundled Alpine wpa_supplicant (the vendor one cannot link against the recovery's libcrypto)
  if [ -x /system/bin/nx-wpa_supplicant ] && /system/bin/nx-wpa_supplicant -v >/dev/null 2>&1; then
    /system/bin/nx-wpa_supplicant -iwlan0 -Dnl80211 -c "$1" -dd >> $RUN/wpa.out 2>&1 &
  else
    $WPA -iwlan0 -Dnl80211 -c "$1" -dd >> $RUN/wpa.out 2>&1 &
  fi
  sleep 1
}

scan() {
  [ -e /sys/class/net/wlan0 ] || up || return 1
  # a dummy network makes wpa_supplicant scan; results come from its debug output (no wpa_cli in recovery)
  printf 'ctrl_interface=%s/sock\nap_scan=1\nnetwork={\n  ssid="noxis-scan-dummy-%s"\n  key_mgmt=NONE\n  scan_ssid=0\n}\n' $RUN $$ > $RUN/scan.conf
  supplicant $RUN/scan.conf
  log "scanning 10 s ..."
  sleep 10
  pkill -f "wpa_supplicant.*$RUN" 2>/dev/null
  echo "   SIGNAL  CH-FREQ  NETWORK"
  grep -oE "BSS: Add new id [0-9]+ BSSID [0-9a-f:]+ SSID '[^']*' freq [0-9]+" $RUN/wpa.out | \
    sed -E "s/.*SSID '([^']*)' freq ([0-9]+)/\2 \1/" | sort -u -k2 | \
    while read f n; do [ -n "$n" ] && printf '            %-6s  %s\n' "$f" "$n"; done | tee -a $LOG
  grep -qE "BSS: Add new id" $RUN/wpa.out || { log "! no networks found"; tail -40 $RUN/wpa.out >> $LOG; }
}

connect() {
  [ -n "$1" ] || { echo "usage: noxis-wifi connect SSID [PASS]"; return 1; }
  [ -e /sys/class/net/wlan0 ] || up || return 1
  ssid=$(printf '%s' "$1" | sed 's/"/\\"/g'); pass=$(printf '%s' "$2" | sed 's/"/\\"/g')
  {
    echo "ctrl_interface=$RUN/sock"; echo "network={"; echo "  ssid=\"$ssid\""; echo "  scan_ssid=1"
    if [ -n "$2" ]; then echo "  psk=\"$pass\""; echo "  key_mgmt=WPA-PSK SAE"; echo "  ieee80211w=1"; else echo "  key_mgmt=NONE"; fi
    echo "}"
  } > $RUN/wpa.conf
  chmod 600 $RUN/wpa.conf
  supplicant $RUN/wpa.conf
  log "connecting to $1 ..."
  i=0; while [ $i -lt 30 ]; do
    grep -q "CTRL-EVENT-CONNECTED" $RUN/wpa.out && break
    grep -qE "WRONG_KEY|4-Way Handshake failed|CTRL-EVENT-SSID-TEMP-DISABLED" $RUN/wpa.out && break
    sleep 1; i=$((i+1))
  done
  if grep -q "CTRL-EVENT-CONNECTED" $RUN/wpa.out; then
    log "OK: connected to $1"; dhcp
  else
    grep -E "CTRL-EVENT|WRONG_KEY|reason=" $RUN/wpa.out | grep -v psk | tail -15 | tee -a $LOG
    log "! not connected (wrong password? only 6 GHz?)"; return 1
  fi
}

dhcp() {
  [ -x $BB ] || { log "! nxbusybox missing – set an IP by hand"; return 1; }
  cat > $RUN/udhcpc.sh <<'EOF'
#!/system/bin/sh
case "$1" in
  bound|renew)
    /system/bin/nxbusybox ip addr flush dev "$interface"
    /system/bin/nxbusybox ip addr add "$ip/${mask:-24}" dev "$interface"
    for r in $router; do /system/bin/nxbusybox ip route replace default via "$r" dev "$interface"; break; done
    : > /etc/resolv.conf
    for d in ${dns:-1.1.1.1}; do echo "nameserver $d" >> /etc/resolv.conf; done ;;
esac
EOF
  chmod 755 $RUN/udhcpc.sh
  run $BB udhcpc -i wlan0 -s $RUN/udhcpc.sh -n -q -t 8
  grep -q nameserver /etc/resolv.conf 2>/dev/null || echo "nameserver 9.9.9.9" > /etc/resolv.conf
  log "IP: $(ifconfig wlan0 | grep -i "inet ")"
  if $BB wget -q -O /dev/null -T 8 https://github.com 2>>$LOG; then log "OK: internet works"; else log "! no internet (DNS/route) – see log"; fi
}

case "${1:-}" in
  probe) probe ;;
  up) up ;;
  scan) scan ;;
  connect) shift; connect "$@" ;;
  status) ifconfig wlan0; grep -E "CTRL-EVENT-(CONNECTED|DISCONNECTED)" $RUN/wpa.out 2>/dev/null | tail -2; cat /etc/resolv.conf 2>/dev/null ;;
  down) pkill -f "wpa_supplicant.*$RUN"; ifconfig wlan0 down; log "down" ;;
  *) sed -n '2,12p' "$0" ;;
esac
